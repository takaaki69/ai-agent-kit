{
  "permissions": {
    "allow": [
      "Bash(bash /home/user/ai-agent-kit/*)",
      "Bash(python3 /home/user/ai-agent-kit/*)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/ai-agent-kit/install.sh >/dev/null 2>&1; bash /home/user/ai-agent-kit/doctor.sh 2>&1 | grep -A3 TODO || true"
          }
        ]
      }
    ]
  }
}
